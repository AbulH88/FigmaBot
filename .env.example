# MXroute DirectAdmin API Credentials
DA_URL=https://your-server.mxrouting.net:2222
DA_USERNAME=your_username
DA_PASSWORD=your_password
EMAIL_DOMAIN=yourdomain.com

# MXroute IMAP Details (to read verification emails)
IMAP_HOST=your-server.mxrouting.net
IMAP_PORT=993

# 2Captcha API Key (to bypass Figma's bot protection)
# Get this from https://2captcha.com/
TWOCAPTCHA_API_KEY=your_2captcha_api_key

# Script configuration
# How many accounts to create per run
ACCOUNTS_TO_CREATE=5

# Web dashboard security
# Optional: require a password to access the dashboard (any username, this password)
# DASHBOARD_PASSWORD=choose_a_strong_password
# By default the dashboard only listens on 127.0.0.1 (this machine).
# To access it from other devices, set HOST=0.0.0.0 and set DASHBOARD_PASSWORD.
# HOST=0.0.0.0
